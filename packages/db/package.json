{
  "name": "@medsoft/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./schema/partner-clinics": {
      "types": "./dist/schema/partner-clinics.d.ts",
      "default": "./dist/schema/partner-clinics.js"
    },
    "./schema/identity-links": {
      "types": "./dist/schema/identity-links.d.ts",
      "default": "./dist/schema/identity-links.js"
    },
    "./schema/ecosystem-appointments": {
      "types": "./dist/schema/ecosystem-appointments.d.ts",
      "default": "./dist/schema/ecosystem-appointments.js"
    },
    "./schema/consents": {
      "types": "./dist/schema/consents.d.ts",
      "default": "./dist/schema/consents.js"
    },
    "./schema/discharge-documents": {
      "types": "./dist/schema/discharge-documents.d.ts",
      "default": "./dist/schema/discharge-documents.js"
    },
    "./schema/exchange-audit": {
      "types": "./dist/schema/exchange-audit.d.ts",
      "default": "./dist/schema/exchange-audit.js"
    },
    "./schema/aivita": {
      "types": "./dist/schema/aivita.d.ts",
      "default": "./dist/schema/aivita.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.10",
    "drizzle-zod": "^0.5.1",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "drizzle-kit": "^0.21.4",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
